  "roadmap": {
    "source": "<template>\n  <section class=\"aheart-roadmap\" aria-labelledby=\"aheart-roadmap-title\">\n    <header class=\"aheart-roadmap__hero\">\n      <h1 id=\"aheart-roadmap-title\">v2 路线图</h1>\n      <p>\n        路线图按已批准的 A1 阶段划分。M3 进入 AI/DND 按需入口、Resolver\n        与文档迁移。\n      </p>\n      <aside class=\"aheart-roadmap__guardrail\">\n        公开版本、候选包和阶段验收分别记录。候选按需入口使用本地 tarball 验证。\n      </aside>\n    </header>\n\n    <ol class=\"aheart-roadmap__timeline\">\n      <li\n        v-for=\"phase in phases\"\n        :key=\"phase.key\"\n        class=\"aheart-roadmap__phase\"\n      >\n        <div class=\"aheart-roadmap__phase-marker\" aria-hidden=\"true\">\n          {{ phase.key }}\n        </div>\n        <article>\n          <div class=\"aheart-roadmap__phase-heading\">\n            <div>\n              <h2>{{ phase.title }}</h2>\n              <p>{{ phase.description }}</p>\n            </div>\n            <span\n              class=\"aheart-status\"\n              :class=\"`aheart-status--${phase.state}`\"\n              >{{ phase.status }}</span\n            >\n          </div>\n          <ul>\n            <li v-for=\"item in phase.items\" :key=\"item\">{{ item }}</li>\n          </ul>\n        </article>\n      </li>\n    </ol>\n  </section>\n</template>\n\n<script setup lang=\"ts\">\nconst phases = [\n  {\n    key: \"M0\",\n    title: \"产品与契约冻结\",\n    description: \"建立版本边界和两个消费试点。\",\n    status: \"已验收\",\n    state: \"ready\",\n    items: [\"clean-consumer 和 ai-review-gate\"],\n  },\n  {\n    key: \"M1\",\n    title: \"v1.2 真实按需\",\n    description: \"建立基础包子入口与显式样式契约。\",\n    status: \"已验收\",\n    state: \"ready\",\n    items: [\"Button / Modal / Select 子入口\", \"消费端和发布契约\"],\n  },\n  {\n    key: \"M2\",\n    title: \"Combobox 与浮层\",\n    description: \"通过单选示例验证公共浮层和键盘操作。\",\n    status: \"已部署\",\n    state: \"ready\",\n    items: [\n      \"Combobox\",\n      \"Popover / Tooltip / Dropdown、Modal / Drawer、Select 与 Picker 族\",\n    ],\n  },\n  {\n    key: \"M3\",\n    title: \"AI/DND 与文档\",\n    description: \"拆分场景入口和样式，并提供静态 Resolver 与迁移指南。\",\n    status: \"候选\",\n    state: \"preview\",\n    items: [\n      \"Chat / Agent / Workbench、DND Sortable\",\n      \"按需导入、自动解析和回滚\",\n    ],\n  },\n  {\n    key: \"M4\",\n    title: \"v2 发布决策\",\n    description: \"根据试点反馈、主线质量和回滚证据决定发布节奏。\",\n    status: \"待评估\",\n    state: \"planned\",\n    items: [\"Beta / RC / Stable\"],\n  },\n];\n</script>\n",
