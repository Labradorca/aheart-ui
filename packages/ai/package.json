{
  "name": "@aheart-ui/ai",
  "version": "2.0.0-rc.0",
  "description": "Vue 3 AI interface components for Aheart UI.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./style.css": "./dist/styles/style.css",
    "./es/*": "./dist/compat/es/*",
    "./lib/*": "./dist/compat/lib/*",
    "./package.json": "./package.json",
    "./actions": {
      "types": "./dist/types/actions/index.d.ts",
      "import": "./dist/esm/actions/index.js",
      "require": "./dist/cjs/actions/index.js"
    },
    "./actions/style.css": "./dist/styles/actions/style.css",
    "./attachments": {
      "types": "./dist/types/attachments/index.d.ts",
      "import": "./dist/esm/attachments/index.js",
      "require": "./dist/cjs/attachments/index.js"
    },
    "./attachments/style.css": "./dist/styles/attachments/style.css",
    "./bubble": {
      "types": "./dist/types/bubble/index.d.ts",
      "import": "./dist/esm/bubble/index.js",
      "require": "./dist/cjs/bubble/index.js"
    },
    "./bubble/style.css": "./dist/styles/bubble/style.css",
    "./conversations": {
      "types": "./dist/types/conversations/index.d.ts",
      "import": "./dist/esm/conversations/index.js",
      "require": "./dist/cjs/conversations/index.js"
    },
    "./conversations/style.css": "./dist/styles/conversations/style.css",
    "./form": {
      "types": "./dist/types/form/index.d.ts",
      "import": "./dist/esm/form/index.js",
      "require": "./dist/cjs/form/index.js"
    },
    "./form/style.css": "./dist/styles/form/style.css",
    "./process": {
      "types": "./dist/types/process/index.d.ts",
      "import": "./dist/esm/process/index.js",
      "require": "./dist/cjs/process/index.js"
    },
    "./process/style.css": "./dist/styles/process/style.css",
    "./prompts": {
      "types": "./dist/types/prompts/index.d.ts",
      "import": "./dist/esm/prompts/index.js",
      "require": "./dist/cjs/prompts/index.js"
    },
    "./prompts/style.css": "./dist/styles/prompts/style.css",
    "./sender": {
      "types": "./dist/types/sender/index.d.ts",
      "import": "./dist/esm/sender/index.js",
      "require": "./dist/cjs/sender/index.js"
    },
    "./sender/style.css": "./dist/styles/sender/style.css",
    "./sources": {
      "types": "./dist/types/sources/index.d.ts",
      "import": "./dist/esm/sources/index.js",
      "require": "./dist/cjs/sources/index.js"
    },
    "./sources/style.css": "./dist/styles/sources/style.css",
    "./thought-chain": {
      "types": "./dist/types/thought-chain/index.d.ts",
      "import": "./dist/esm/thought-chain/index.js",
      "require": "./dist/cjs/thought-chain/index.js"
    },
    "./thought-chain/style.css": "./dist/styles/thought-chain/style.css",
    "./welcome": {
      "types": "./dist/types/welcome/index.d.ts",
      "import": "./dist/esm/welcome/index.js",
      "require": "./dist/cjs/welcome/index.js"
    },
    "./welcome/style.css": "./dist/styles/welcome/style.css",
    "./chat-panel": {
      "types": "./dist/types/chat-panel/index.d.ts",
      "import": "./dist/esm/chat-panel/index.js",
      "require": "./dist/cjs/chat-panel/index.js"
    },
    "./chat-panel/style.css": "./dist/styles/chat-panel/style.css",
    "./agent-workbench": {
      "types": "./dist/types/agent-workbench/index.d.ts",
      "import": "./dist/esm/agent-workbench/index.js",
      "require": "./dist/cjs/agent-workbench/index.js"
    },
    "./agent-workbench/style.css": "./dist/styles/agent-workbench/style.css",
    "./chat": {
      "types": "./dist/types/chat/index.d.ts",
      "import": "./dist/esm/chat/index.js",
      "require": "./dist/cjs/chat/index.js"
    },
    "./chat/style.css": "./dist/styles/chat/style.css",
    "./agent": {
      "types": "./dist/types/agent/index.d.ts",
      "import": "./dist/esm/agent/index.js",
      "require": "./dist/cjs/agent/index.js"
    },
    "./agent/style.css": "./dist/styles/agent/style.css",
    "./workbench": {
      "types": "./dist/types/agent-workbench/index.d.ts",
      "import": "./dist/esm/agent-workbench/index.js",
      "require": "./dist/cjs/agent-workbench/index.js"
    },
    "./workbench/style.css": "./dist/styles/agent-workbench/style.css",
    "./full": {
      "types": "./dist/types/full.d.ts",
      "import": "./dist/esm/full.js",
      "require": "./dist/cjs/full.js"
    },
    "./full.css": "./dist/styles/style.css",
    "./es/*.d.ts": "./dist/compat/es/*.d.ts",
    "./es/*.css": "./dist/compat/es/*.css",
    "./lib/*.d.ts": "./dist/compat/lib/*.d.ts",
    "./lib/*.css": "./dist/compat/lib/*.css",
    "./es/*.js": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/compat/es/*.js"
    },
    "./lib/*.js": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/compat/lib/*.js"
    },
    "./es/index.js": {
      "types": "./dist/types/full.d.ts",
      "default": "./dist/compat/es/index.js"
    },
    "./lib/index.js": {
      "types": "./dist/types/full.d.ts",
      "default": "./dist/compat/lib/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --environment jsdom",
    "test:coverage": "vitest run --environment jsdom --coverage"
  },
  "keywords": [
    "aheart-ui",
    "vue3",
    "ai",
    "chat",
    "agent",
    "form"
  ],
  "author": "小凡",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzfdhr/aheart-ui.git",
    "directory": "packages/ai"
  },
  "homepage": "https://github.com/wzfdhr/aheart-ui#readme",
  "bugs": {
    "url": "https://github.com/wzfdhr/aheart-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "aheart-ui": "workspace:^2.0.0-alpha.0",
    "vue": ">=3.5.0 <4",
    "@aheart-ui/dnd": "workspace:^1.1.0"
  },
  "devDependencies": {
    "@aheart-ui/dnd": "workspace:^1.1.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitest/coverage-v8": "1.6.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^24.1.1",
    "vite": "^5.0.12",
    "vite-plugin-dts": "^3.7.2",
    "vitest": "^1.6.1",
    "vue": "^3.5.38",
    "vue-tsc": "^2.0.29"
  },
  "peerDependenciesMeta": {
    "@aheart-ui/dnd": {
      "optional": true
    }
  }
}
